# Copy to `.env.local` and fill in. The test suite forks these networks with
# Anvil, so prefer your own RPC endpoints (the public defaults below are rate
# limited and flaky under a full test run).

# L1 mainnet fork (default: https://cloudflare-eth.com)
VITE_ANVIL_FORK_URL=
# L1 Sepolia fork (default: https://rpc.sepolia.org)
VITE_ANVIL_FORK_URL_SEPOLIA=
# Mantle (L2) fork (default: https://rpc.mantle.xyz)
VITE_ANVIL_FORK_URL_MANTLE=
# Mantle Sepolia (L2 testnet) fork (default: https://rpc.sepolia.mantle.xyz)
VITE_ANVIL_FORK_URL_MANTLE_SEPOLIA=

# Only needed for the opt-in `e2e` tests (which are `.skip`-ped by default and
# send real transactions against a live network). The default test suite uses
# Anvil's deterministic accounts and does NOT require this. Leave empty unless
# you are deliberately running an e2e test.
VITE_ACCOUNT_PRIVATE_KEY=

# --- Optional / advanced (defaults are fine for normal runs) ---
# Batch eth_call via multicall in the test transport. Values: true | false
# VITE_BATCH_MULTICALL=true
# Transport used by the test clients. Values: http | webSocket | ipc
# VITE_NETWORK_TRANSPORT_MODE=http
